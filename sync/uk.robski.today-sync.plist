<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>uk.robski.today-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPO_PATH/sync/run-sync.sh</string>
  </array>

  <!-- Every 15 minutes. Tana is only reachable while the Mac is awake and the
       desktop app is running, so this is best-effort by nature. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <!-- Catch up shortly after login rather than waiting a full interval. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>HOME_PATH/Library/Logs/today-sync.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_PATH/Library/Logs/today-sync.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <!-- Don't wake the Mac just for this; a missed run is fine. -->
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
