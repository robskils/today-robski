{
  "name": "today-robski",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "today.robski.uk - a one-day retreat schedule pulling Google Calendar + Tana tasks",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node worker/time.test.mjs && node worker/auth.test.mjs && node worker/brief.test.mjs && node shared/lanes.test.mjs && node shared/event-lane.test.mjs",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:staging": "wrangler d1 execute daybook-staging --remote --file worker/schema.sql",
    "db:staging:mt": "wrangler d1 execute daybook-staging --remote --file worker/schema-tenant.sql",
    "sync": "node sync/sync.js",
    "sync:dry": "node sync/sync.js --dry-run",
    "google-auth": "node sync/google-auth.js",
    "audit": "node worker/audit-schema.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.87.0"
  },
  "dependencies": {
    "postal-mime": "^2.7.6"
  }
}
