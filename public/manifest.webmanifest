{
  "name": "Koyeba",
  "short_name": "Koyeba",
  "description": "For a life well lived. Your calendar, tasks, notes, reflections and money in one calm, private place.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8f4ec",
  "theme_color": "#f8f4ec",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "/icon-192.v14.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.v14.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.v14.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/today", "icons": [{ "src": "/icon-192.v14.png", "sizes": "192x192" }] },
    { "name": "Mail", "url": "/mail", "icons": [{ "src": "/icon-192.v14.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "/tasks", "icons": [{ "src": "/icon-192.v14.png", "sizes": "192x192" }] },
    { "name": "Well-being", "url": "/journal", "icons": [{ "src": "/icon-192.v14.png", "sizes": "192x192" }] }
  ],
  "protocol_handlers": [
    { "protocol": "mailto", "url": "/mail?mailto=%s" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
